# Copy to .env and adjust as needed. Nothing here is required to run the demo —
# every value has a safe, offline default (see app/config.py).

ENVIRONMENT=development

# sqlite (zero setup) or postgresql+psycopg2://user:pass@host:5432/db
DATABASE_URL=sqlite:///./app/data/pragati.db

# --- LLM provider (mock = deterministic, offline, no API key needed) ---
# One of: mock | anthropic | openai | groq | gemini | nvidia | failover
#   failover chains LLM_FAILOVER_ORDER (below), using whichever of those have
#   a key set, and moves to the next one on any error/rate-limit/bad response.
LLM_PROVIDER=mock
# Leave unset to use each provider's own default model (see app/llm/*_provider.py).
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=        # https://console.groq.com — OpenAI-compatible, very fast Llama/GPT-OSS/Kimi inference
# GEMINI_API_KEY=      # https://aistudio.google.com/apikey — OpenAI-compatible endpoint, generous free tier
# NVIDIA_API_KEY=      # https://build.nvidia.com — OpenAI-compatible NIM endpoint (Nemotron etc.), free tier available
# Only used when LLM_PROVIDER=failover. JSON array, tried in order.
# LLM_FAILOVER_ORDER=["groq","gemini","nvidia"]
# Must be explicitly set to true, in addition to picking a real provider above,
# before any document content is sent to an external LLM API.
ALLOW_EXTERNAL_LLM_CALLS=false

# --- OCR provider ---
# One of: auto | tesseract | mock | nvidia
# auto tries Tesseract if installed, otherwise falls back to a clearly-labelled mock.
# nvidia uses NVIDIA's hosted Nemotron OCR v2 (also gated by ALLOW_EXTERNAL_LLM_CALLS above).
OCR_PROVIDER=auto
# https://build.nvidia.com/nvidia/nemotron-ocr-v2
# NVIDIA_OCR_API_KEY=

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- CORS: which frontend origins may call this API ---
# This list is for LOCAL DEV origins only. It does NOT need Vercel domains —
# production (https://pragati-ai-agents.vercel.app) and every Vercel preview/
# branch URL are matched unconditionally by CORS_ORIGIN_REGEX's built-in
# default in app/config.py, independent of whatever is set here. A real
# deployed API server should set its own CORS_ORIGINS/CORS_ORIGIN_REGEX as
# platform environment variables — never by copying this local file.
# Must be a JSON array (pydantic-settings requires this exact format for a
# tuple field via env vars — a plain comma-separated string will error out).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Only set this to override the Vercel-matching default above — leave unset
# otherwise. If you do set it, never set it to an empty string: an empty
# regex matches every origin, which combined with allow_credentials=True
# would open CORS to the entire internet.
# CORS_ORIGIN_REGEX=^https://pragati-ai-agents(-[a-zA-Z0-9-]+)?\.vercel\.app$

# Override only if running outside the default apps/api/apps/web monorepo layout
# (e.g. inside Docker, where the knowledge folder is mounted at /knowledge).
# KNOWLEDGE_DIR=/knowledge
