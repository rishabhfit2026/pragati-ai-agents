# Copy to .env and adjust as needed. Nothing here is required to run the demo —
# every value has a safe, offline default (see app/config.py).

ENVIRONMENT=development

# sqlite (zero setup) or postgresql+psycopg2://user:pass@host:5432/db
DATABASE_URL=sqlite:///./app/data/pragati.db

# --- LLM provider (mock = deterministic, offline, no API key needed) ---
# One of: mock | anthropic | openai | groq | nvidia
LLM_PROVIDER=mock
# Leave unset to use each provider's own default model (see app/llm/*_provider.py).
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=        # https://console.groq.com — OpenAI-compatible, very fast Llama/GPT-OSS/Kimi inference
# NVIDIA_API_KEY=      # https://build.nvidia.com — OpenAI-compatible NIM endpoint, free tier available
# Must be explicitly set to true, in addition to picking a real provider above,
# before any document content is sent to an external LLM API.
ALLOW_EXTERNAL_LLM_CALLS=false

# --- OCR provider ---
# auto tries Tesseract if installed, otherwise falls back to a clearly-labelled mock.
OCR_PROVIDER=auto

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- CORS: which frontend origins may call this API ---
CORS_ORIGINS=["http://localhost:3000"]

# Override only if running outside the default apps/api/apps/web monorepo layout
# (e.g. inside Docker, where the knowledge folder is mounted at /knowledge).
# KNOWLEDGE_DIR=/knowledge
